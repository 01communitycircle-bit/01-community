# 0.1% COMMUNITY - PRODUCTION CONFIGURATION
# ---------------------------------------------
# Simply add these to your Vercel Project Settings > Environment Variables

# App URL
NEXT_PUBLIC_APP_URL="https://0point1percent.com"

# Supabase (Database + Auth + Storage)
# Recommended backend for sub-20ms queries & zero cold starts on Vercel
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Razorpay / Payments (₹1,000 Pro Plan)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpaySecret"
RAZORPAY_WEBHOOK_SECRET="yourWebhookSecret"

# Community Notifications
ADMIN_NOTIFICATION_EMAIL="owner@0point1percent.com"
ADMIN_WHATSAPP_NUMBER="+919800011223"
